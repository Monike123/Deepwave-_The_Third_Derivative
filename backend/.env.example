# Copy to backend/.env and fill in only the services you use.
# None of these are required for local image, video, and audio analysis.

# Folder that holds the weight files. Defaults to <repo>/Models.
# MODELS_DIR=C:\path\to\Models

# Set to true only when a CUDA build of torch / onnxruntime is installed.
USE_GPU=false

# Optional. Hugging Face token for the cloud analytics engine.
HF_TOKEN=

# Optional. NVIDIA API key for the Hive cloud engine.
NVIDIA_API_KEY=

# Optional. MongoDB URI. The API runs without storage when this is empty.
MONGODB_URI=
